{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "$schema": {
      "type": "string"
    },
    "routing_mode": {
      "anyOf": [
        {
          "enum": ["ordered", "main-first", "fallback-first", "sticky-balanced"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "enum": [
                "ordered",
                "main-first",
                "fallback-first",
                "sticky-balanced"
              ]
            },
            "opencode": {
              "enum": [
                "ordered",
                "main-first",
                "fallback-first",
                "sticky-balanced"
              ]
            },
            "pi": {
              "enum": [
                "ordered",
                "main-first",
                "fallback-first",
                "sticky-balanced"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "max_same_account_wait": {
      "anyOf": [
        {
          "enum": ["off", "15m", "cache"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "enum": ["off", "15m", "cache"]
            },
            "opencode": {
              "enum": ["off", "15m", "cache"]
            },
            "pi": {
              "enum": ["off", "15m", "cache"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fallback_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "opencode": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "pi": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "refresh_enabled": {
      "type": "boolean"
    },
    "refresh_before_expiry_minutes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "opencode": {
              "type": "number"
            },
            "pi": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "quota_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            },
            "opencode": {
              "type": "boolean"
            },
            "pi": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "quota_check_interval_minutes": {
      "type": "number",
      "minimum": 1
    },
    "quota_minimum_remaining": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window": {
                "enum": ["primary", "secondary"]
              },
              "floor": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "required": ["window", "floor"]
          }
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "window": {
                    "enum": ["primary", "secondary"]
                  },
                  "floor": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": ["window", "floor"]
              }
            },
            "opencode": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "window": {
                    "enum": ["primary", "secondary"]
                  },
                  "floor": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": ["window", "floor"]
              }
            },
            "pi": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "window": {
                    "enum": ["primary", "secondary"]
                  },
                  "floor": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": ["window", "floor"]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "quota_fail_closed_on_unknown": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            },
            "opencode": {
              "type": "boolean"
            },
            "pi": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cost_zeroing": {
      "type": "boolean"
    },
    "killswitch_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            },
            "opencode": {
              "type": "boolean"
            },
            "pi": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "killswitch_default_primary": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "opencode": {
              "type": "number"
            },
            "pi": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "killswitch_default_secondary": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "opencode": {
              "type": "number"
            },
            "pi": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "killswitch_account_floors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "host": {
            "enum": ["opencode", "pi", "both"]
          },
          "primary": {
            "type": "number"
          },
          "secondary": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": ["account", "host", "primary", "secondary"]
      }
    },
    "cache_keep_enabled": {
      "type": "boolean"
    },
    "cache_keep_subagents": {
      "type": "boolean"
    },
    "cache_keep_sustain": {
      "type": "boolean"
    },
    "cache_keep_window": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "end_hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        },
        "additionalProperties": false,
        "required": ["start_hour", "end_hour"]
      }
    },
    "log_level": {
      "enum": ["error", "warn", "info", "debug", "trace", "default"]
    },
    "request_dumps": {
      "type": "boolean"
    },
    "dump_dir": {
      "type": "string"
    },
    "dump_max_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "web_sockets": {
      "type": "boolean"
    },
    "raw_web_socket": {
      "type": "boolean"
    },
    "responses_lite": {
      "type": "boolean"
    },
    "codex_api_endpoint": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
