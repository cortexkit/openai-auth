{
  "name": "@cortexkit/opencode-openai-auth",
  "version": "0.8.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortexkit/openai-auth.git",
    "directory": "packages/opencode"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./src/tui/entry.mjs"
    },
    "./tui-prefs": {
      "types": "./dist/tui-preferences.d.ts",
      "import": "./dist/tui-preferences.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "files": [
    "dist",
    "src/tui/entry.mjs",
    "src/tui-compiled",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/sidebar-state.ts src/tui-preferences.ts src/rpc/rpc-client.ts src/rpc/port-file.ts src/rpc/protocol.ts src/rpc/rpc-dir.ts --outdir dist --target node --format esm --splitting --external @opencode-ai/plugin --minify && bun run build:types && bun run build:tui",
    "build:tui": "bun scripts/build-tui.ts",
    "build:types": "cd ../core && bun run build && cd ../opencode && tsdown --config tsdown.config.ts",
    "build:dev": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test src/tests",
    "typecheck": "tsc",
    "types": "tsc",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@cortexkit/openai-auth-core": "workspace:*"
  },
  "dependencies": {
    "@cortexkit/subc-client": "^0.8.1",
    "@opentui/core": ">=0.5.11",
    "@opentui/solid": ">=0.5.11",
    "ai": "^7.0.99",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12"
  }
}
